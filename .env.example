# Postgres
DATABASE_URL="postgresql://raisely:raisely@localhost:5432/raisely?schema=public"

# Redis / BullMQ
REDIS_URL="redis://localhost:6379"

# Anthropic
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"

# Outreach destinations
HEYREACH_API_KEY=""

# Billing (Stripe) - only apps/api needs these. Without STRIPE_SECRET_KEY set,
# /billing/checkout-session and /billing/portal-session return 503 rather
# than failing, and usage metering/limits still work (every workspace is
# just permanently on the free plan's limit). STRIPE_PRICE_ID_PRO is the
# monthly subscription Price id for the Pro plan in your Stripe dashboard.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_PRO=""

# Auth.js - shared between apps/api (verifies tokens) and apps/web (mints
# them from the session), so AUTH_SECRET must be identical in both. Generate
# one with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
EMAIL_SERVER=""
EMAIL_FROM="Raisely <auth@raisely.dev>"
# Lets you sign in as a seeded demo user with no real OAuth/SMTP configured.
# Leave unset (or "false") in any real deployment.
AUTH_ENABLE_DEV_LOGIN="false"

# API
API_PORT=4000
WEB_PORT=3000
NEXT_PUBLIC_API_URL="http://localhost:4000"
