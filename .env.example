# Postgres
DATABASE_URL="postgresql://raisely:raisely@localhost:5432/raisely?schema=public"

# Redis / BullMQ
REDIS_URL="redis://localhost:6379"

# Anthropic
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"

# Outreach destinations
HEYREACH_API_KEY=""

# Stripe billing (Phase 6). STRIPE_PRICE_* are Price IDs (price_...), not Product IDs -
# create one recurring Price per plan in the Stripe Dashboard/API and paste its id here.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""

# Auth.js - AUTH_SECRET must be the SAME value on both apps/web and apps/api
# (apps/web mints a short-lived bearer JWT from the NextAuth session; apps/api
# verifies it independently against this shared secret). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
EMAIL_SERVER=""
EMAIL_FROM="Raisely <auth@raisely.dev>"
# Registers a password-less "sign in as any seeded demo user" provider - local/dev
# convenience only. Leave unset (or "false") in every deployed environment; the
# provider does not just hide when this is off, it never registers at all (see
# apps/web/src/auth.ts), so there is no way to reach it without this flag.
AUTH_ENABLE_DEV_LOGIN="false"

# API
API_PORT=4000
WEB_PORT=3000
NEXT_PUBLIC_API_URL="http://localhost:4000"
