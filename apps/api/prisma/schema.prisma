generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  FOUNDER
  ADVISOR
}

enum WorkspaceRole {
  OWNER
  ADVISOR
  MEMBER
}

enum InvestorType {
  VC
  ANGEL
  FAMILY_OFFICE
  CVC
  STRATEGIC
}

enum DataSource {
  MANUAL
  LINKEDIN_IMPORT
  GOOGLE_IMPORT
  CSV_IMPORT
  ENRICHMENT_API
  AI_INFERRED
}

enum SearchStatus {
  DRAFT
  QUEUED
  RUNNING
  COMPLETE
  FAILED
}

enum LeadTier {
  A
  B
  C
}

enum PipelineStage {
  IDENTIFIED
  CONTACTED
  REPLIED
  MEETING
  DILIGENCE
  TERM_SHEET
  PASSED
}

enum ExclusionSource {
  MANUAL
  LINKEDIN_IMPORT
  CSV
}

enum EnrichmentJobStatus {
  QUEUED
  RUNNING
  COMPLETE
  FAILED
}

enum DiscoveryRunStatus {
  QUEUED
  RUNNING
  AWAITING_APPROVAL
  APPROVED
  COMPLETE
  FAILED
}

enum UsageEventType {
  SEARCH
  ENRICHMENT
  DISCOVERY_RUN
  OUTREACH_DRAFT
  EXPORT
}

enum NotificationType {
  DISCOVERY_RUN_STATUS_CHANGED
}

// Mirrors Stripe's own Subscription.status values directly - this is a
// closed set because it's populated only from Stripe webhook payloads,
// never typed in by a user.
enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  INCOMPLETE
  INCOMPLETE_EXPIRED
}

// ---------------------------------------------------------------------------
// Auth (Auth.js / next-auth Prisma adapter shape) + Users
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  role          UserRole  @default(FOUNDER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  ownedWorkspaces Workspace[]       @relation("WorkspaceOwner")
  memberships     WorkspaceMember[]
  searches        Search[]
  discoveryRuns   DiscoveryRun[]
  usageEvents     UsageEvent[]
  notifications   Notification[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Workspaces (advisor mode: one user, many workspaces, isolated data)
// ---------------------------------------------------------------------------

model Workspace {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  ownerId         String
  plan            String   @default("free")
  usageLimit      Int      @default(50)
  // Founder's one-liner for the company being raised for - used as context
  // for Claude-drafted outreach (Phase 5). Optional: advisor workspaces or
  // ones that haven't set it yet just get a slightly more generic draft.
  companyOneLiner String?  @db.Text

  // --- Billing (Phase 6) ---
  // Null until the workspace's first Stripe Checkout session completes.
  // `plan`/`usageLimit` above stay the source of truth for what a workspace
  // can actually do; these fields exist to reconcile with Stripe (map
  // incoming webhook events back to a workspace, and to open a billing
  // portal session) rather than to gate anything directly.
  stripeCustomerId     String?             @unique
  stripeSubscriptionId String?             @unique
  subscriptionStatus   SubscriptionStatus?
  currentPeriodEnd     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner User @relation("WorkspaceOwner", fields: [ownerId], references: [id])

  members          WorkspaceMember[]
  searches         Search[]
  leads            Lead[]
  exclusionLists   ExclusionList[]
  exclusionEntries ExclusionEntry[]
  discoveryRuns    DiscoveryRun[]
  enrichmentJobs   EnrichmentJob[]
  usageEvents      UsageEvent[]
  warmPaths        WarmPath[]
  notifications    Notification[]
  webhookEndpoints WebhookEndpoint[]
  networkContacts  NetworkContact[]
  outreachDrafts   OutreachDraft[]

  @@index([ownerId])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

// ---------------------------------------------------------------------------
// Investor graph
// ---------------------------------------------------------------------------

model Investor {
  id                String       @id @default(cuid())
  name              String
  type              InvestorType
  thesis            String?      @db.Text
  sectors           String[]
  stages            String[]
  checkMin          Int?
  checkMax          Int?
  geographies       String[]
  fundVintageYear   Int?
  lastFundCloseDate DateTime?
  aum               BigInt?
  website           String?
  linkedinUrl       String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  contacts          Contact[]
  deals             Deal[]
  leads             Lead[]
  enrichmentJobs    EnrichmentJob[]
  thesisMatchScores ThesisMatchScore[]

  @@index([type])
  @@index([name])
  @@map("investors")
}

/**
 * Cache of Claude-computed semantic thesis-match scores, keyed by
 * (investor, query_hash) so repeat searches with the same sector/keyword
 * signal don't re-call the model. Populated by a batched background job
 * (see EnrichmentJob-style workers), never written synchronously from a
 * request.
 */
model ThesisMatchScore {
  id         String   @id @default(cuid())
  investorId String
  queryHash  String
  score      Int // 0-100 semantic match confidence from Claude
  evidence   String   @db.Text
  computedAt DateTime @default(now())

  investor Investor @relation(fields: [investorId], references: [id], onDelete: Cascade)

  @@unique([investorId, queryHash])
  @@index([queryHash])
  @@map("thesis_match_scores")
}

model Contact {
  id              String     @id @default(cuid())
  investorId      String
  name            String
  title           String?
  email           String?
  emailVerifiedAt DateTime?
  linkedinUrl     String?
  dataSource      DataSource @default(MANUAL)
  // Per-field provenance: { fieldName: { value, source, fetched_at } }
  provenance      Json?
  // GDPR opt-out: when set, personal fields have been purged and the
  // contact is globally suppressed from future search/enrichment results.
  suppressedAt    DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  investor Investor @relation(fields: [investorId], references: [id], onDelete: Cascade)

  warmPathsAsTarget WarmPath[] @relation("TargetContact")
  warmPathsAsMutual WarmPath[] @relation("MutualContact")

  @@index([investorId])
  @@index([email])
  @@index([linkedinUrl])
  @@map("contacts")
}

model Deal {
  id         String    @id @default(cuid())
  investorId String
  company    String
  sector     String?
  stage      String?
  date       DateTime?
  amount     Int?
  sourceUrl  String?
  createdAt  DateTime  @default(now())

  investor Investor @relation(fields: [investorId], references: [id], onDelete: Cascade)

  @@index([investorId])
  @@index([company])
  @@index([sector])
  @@map("deals")
}

// ---------------------------------------------------------------------------
// Search / Leads
// ---------------------------------------------------------------------------

model Search {
  id              String       @id @default(cuid())
  workspaceId     String
  createdById     String
  name            String?
  queryText       String?      @db.Text
  // StructuredQuery JSON (see @raisely/shared-types)
  structuredQuery Json
  status          SearchStatus @default(DRAFT)
  saved           Boolean      @default(false)
  // When this Search is a re-run of a saved search, points back to it.
  savedSearchId   String?
  excludedCount   Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy    User           @relation(fields: [createdById], references: [id])
  savedSearch  Search?        @relation("SavedSearchRuns", fields: [savedSearchId], references: [id])
  reruns       Search[]       @relation("SavedSearchRuns")
  leads        Lead[]
  discoveryRun DiscoveryRun[] @relation("DiscoveryResultSearch")

  @@index([workspaceId])
  @@index([createdById])
  @@index([savedSearchId])
  @@map("searches")
}

model Lead {
  id            String        @id @default(cuid())
  workspaceId   String
  searchId      String
  investorId    String
  fitScore      Int?
  // Structured fit evidence, see FitScoreResult in @raisely/shared-types
  fitReasons    Json?
  tier          LeadTier?
  pipelineStage PipelineStage @default(IDENTIFIED)
  tags          String[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  search         Search          @relation(fields: [searchId], references: [id], onDelete: Cascade)
  investor       Investor        @relation(fields: [investorId], references: [id], onDelete: Cascade)
  warmPaths      WarmPath[]
  outreachDrafts OutreachDraft[]

  @@unique([searchId, investorId])
  @@index([workspaceId])
  @@index([investorId])
  @@index([pipelineStage])
  @@map("leads")
}

// ---------------------------------------------------------------------------
// Exclusion lists
// ---------------------------------------------------------------------------

model ExclusionList {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  createdAt   DateTime @default(now())

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entries   ExclusionEntry[]

  @@index([workspaceId])
  @@map("exclusion_lists")
}

model ExclusionEntry {
  id              String          @id @default(cuid())
  // Denormalized from exclusionList.workspaceId so this row can be scoped
  // directly by the workspace-isolation Prisma extension without a join -
  // every workspace-owned table carries its own workspaceId for that reason.
  workspaceId     String
  exclusionListId String
  name            String?
  linkedinUrl     String?
  email           String?
  source          ExclusionSource @default(MANUAL)
  createdAt       DateTime        @default(now())

  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  exclusionList ExclusionList @relation(fields: [exclusionListId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([exclusionListId])
  @@index([email])
  @@index([linkedinUrl])
  @@map("exclusion_entries")
}

// ---------------------------------------------------------------------------
// Background jobs / status machines
// ---------------------------------------------------------------------------

model EnrichmentJob {
  id          String              @id @default(cuid())
  workspaceId String
  investorId  String?
  status      EnrichmentJobStatus @default(QUEUED)
  error       String?             @db.Text
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime            @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  investor  Investor? @relation(fields: [investorId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([status])
  @@map("enrichment_jobs")
}

model DiscoveryRun {
  id                  String             @id @default(cuid())
  workspaceId         String
  createdById         String
  comparableCompanies String[]
  status              DiscoveryRunStatus @default(QUEUED)
  // Preview list of candidate investors before approval (Phase 4)
  previewResults      Json?
  resultSearchId      String?
  error               String?            @db.Text
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy    User      @relation(fields: [createdById], references: [id])
  resultSearch Search?   @relation("DiscoveryResultSearch", fields: [resultSearchId], references: [id])

  @@index([workspaceId])
  @@index([status])
  @@map("discovery_runs")
}

// ---------------------------------------------------------------------------
// Notifications + webhooks (emitted on every DiscoveryRun status change, and
// reusable for future async status machines)
// ---------------------------------------------------------------------------

model Notification {
  id          String           @id @default(cuid())
  workspaceId String
  userId      String?
  type        NotificationType
  payload     Json
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([userId])
  @@map("notifications")
}

model WebhookEndpoint {
  id          String   @id @default(cuid())
  workspaceId String
  url         String
  // HMAC-SHA256 signing secret, sent back to the caller once at creation
  // time and never displayed again (Stripe-style).
  secret      String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("webhook_endpoints")
}

// ---------------------------------------------------------------------------
// Warm paths
// ---------------------------------------------------------------------------

model WarmPath {
  id              String   @id @default(cuid())
  workspaceId     String
  leadId          String?
  targetContactId String
  mutualContactId String?
  // Free-text name for network contacts imported from LinkedIn/Google that
  // aren't themselves an investor Contact row.
  mutualName      String?
  strengthScore   Int?
  verified        Boolean  @default(false)
  createdAt       DateTime @default(now())

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead          Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  targetContact Contact   @relation("TargetContact", fields: [targetContactId], references: [id], onDelete: Cascade)
  mutualContact Contact?  @relation("MutualContact", fields: [mutualContactId], references: [id], onDelete: SetNull)

  @@unique([leadId, targetContactId])
  @@index([workspaceId])
  @@index([targetContactId])
  @@index([leadId])
  @@map("warm_paths")
}

/**
 * A person in the founder's own network, imported from a LinkedIn
 * Connections.csv export or (optionally) Google contacts. Used to compute
 * warm paths: when one of these directly matches an investor Contact
 * (by email or LinkedIn URL), the founder already knows that person.
 */
model NetworkContact {
  id          String     @id @default(cuid())
  workspaceId String
  name        String
  email       String?
  linkedinUrl String?
  source      DataSource @default(LINKEDIN_IMPORT)
  // Parsed from the import's "Connected On" column when available - drives
  // the warm-path strength score. Null means we have no recency signal, so
  // any warm path found via this contact is marked unverified.
  connectedAt DateTime?
  createdAt   DateTime   @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([email])
  @@index([linkedinUrl])
  @@map("network_contacts")
}

// ---------------------------------------------------------------------------
// GDPR / compliance
// ---------------------------------------------------------------------------

/**
 * A durable record of a global opt-out request (POST /opt-out, public and
 * unauthenticated - anyone can invoke their right to erasure without an
 * account). Not workspace-scoped: suppression is global by design, since
 * the same investor Contact can be visible to many workspaces and the
 * point is that nobody's data comes back. Checked by every future import/
 * enrichment path before writing PII so an "erased" person doesn't get
 * silently re-added on the next refresh.
 */
model Suppression {
  id          String   @id @default(cuid())
  email       String?
  linkedinUrl String?
  requestedAt DateTime @default(now())
  // Best-effort abuse signal, not identity verification - the endpoint is
  // intentionally unauthenticated, so this is for rate-limit/audit
  // purposes only, never used to gate whether erasure is honored.
  requestIp   String?

  @@index([email])
  @@index([linkedinUrl])
  @@map("suppressions")
}

// ---------------------------------------------------------------------------
// Outreach
// ---------------------------------------------------------------------------

/**
 * A Claude-drafted first line + email for a Lead. Always requires human
 * review/edit before being sent through an OutreachDestination - nothing
 * in this model or its endpoints sends anything on its own.
 */
model OutreachDraft {
  id          String   @id @default(cuid())
  // Denormalized from lead.workspaceId - see ExclusionEntry.workspaceId.
  workspaceId String
  leadId      String
  firstLine   String   @db.Text
  subject     String
  body        String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([leadId])
  @@map("outreach_drafts")
}

// ---------------------------------------------------------------------------
// Metered billing
// ---------------------------------------------------------------------------

model UsageEvent {
  id          String         @id @default(cuid())
  workspaceId String
  userId      String?
  type        UsageEventType
  costUnits   Int
  metadata    Json?
  createdAt   DateTime       @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([type])
  @@index([createdAt])
  @@map("usage_events")
}
